# Chep file nay thanh .env roi dien khoa that vao.
# File .env da nam trong .gitignore nen khong bi commit len git.

# Tang chay loat, mien phi. Lay tai console.groq.com
GROQ_API_KEY=gsk_...

# Tang demo va bang so sanh cuoi. Lay tai platform.openai.com
OPENAI_API_KEY=sk-...

# Tuy chon: doi nha cung cap mac dinh va model ma khong phai sua code.
# KLTN_PROVIDER=groq
# KLTN_GROQ_MODEL=llama-3.3-70b-versatile
# KLTN_OPENAI_MODEL=gpt-4.1-mini
